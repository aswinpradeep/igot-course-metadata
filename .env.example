# =============================================================================
# iGOT Course Metadata Regeneration — Framework v3.5 (Advanced)
# -----------------------------------------------------------------------------
# Copy to .env and fill in real values. NEVER commit .env — it is gitignored.
#
#   cp .env.example .env
#
# Match one environment throughout: if you point DB_DSN at dev, point every
# other service at dev too. Never mix dev and prod values in one file.
# =============================================================================

# ── Google Cloud / Vertex AI (required) ──────────────────────────────────────
# Service-account JSON with Vertex AI User on the project.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
GOOGLE_PROJECT_ID=your-gcp-project-id

# Generation model. gemini-3.1-pro-preview is served ONLY from the "global"
# endpoint — a regional location returns 404. Flash-class models are a marked
# quality regression on the ~55k-token master prompt; the v3.4 baseline ran on
# gemini-2.5-pro, so do not drop below pro class.
#
# META_GEN_MODEL / META_GEN_LOCATION take precedence over GENAI_MODEL_NAME /
# GOOGLE_LOCATION, which exist only as fallbacks for a shared .env where another
# service has already set those two to its own values. If this project owns the
# file, set the META_GEN_* pair and leave the fallbacks unset.
META_GEN_MODEL=gemini-3.1-pro-preview
META_GEN_LOCATION=global
# GENAI_MODEL_NAME=
# GOOGLE_LOCATION=

# ── Databases (required) ─────────────────────────────────────────────────────
# Plain libpq DSN. asyncpg cannot parse SQLAlchemy-style "postgresql+asyncpg://".
# Holds course_processing_checkpoint / course_metadata_regenerated /
# course_processing_errors. Created automatically on first run.
DB_DSN=postgresql://user:password@localhost:5432/karmayogi_db

# Optional, read-only. Supplies platform-verified language / duration /
# difficulty_level from course_metadata_v3 (covers 3395 of 3707 non-SCORM
# courses). Leave blank to infer instead — duration then falls back to VTT cue
# spans, which underestimate (median 0.59x of the true value).
ENRICHMENT_DSN=postgresql://user:password@localhost:5432/cbp_tpc_ai

# ── Input data (required) ────────────────────────────────────────────────────
# Directory of extracted course folders. Either <base>/do_<id>/ directly, or
# <base>/<batch>/do_<id>/ — both layouts are discovered.
COURSES_BASE_PATH=/absolute/path/to/course_data/extracted/non-scorm/_staging

# Deduplicated manifest from tools/inventory.py. Strongly recommended: it is
# what makes --tier work and collapses courses duplicated across batch zips.
COURSE_MANIFEST=/absolute/path/to/course_data/extracted/non-scorm/manifest.jsonl

# Tags rows so SCORM and non-SCORM runs share tables without colliding.
CONTENT_SET=non-scorm

# ── Reference masters (required) ─────────────────────────────────────────────
# KCM: only valid source of Functional/Behavioural competencies (114 pairs).
# Identical to the legacy service's data/competencies.json (md5 b021990a…).
KCM_PATH=/absolute/path/to/competencies 5.json

# SGOS: only valid source of Domain classification (11 sectors → 92 subsectors
# → 460 themes). KCM contains no Domain entries; SGOS *is* the Domain source.
SGOS_PATH=/absolute/path/to/SGOS 1.json

# Official iGOT designation master (19,936 rows, columns id,name) — the only
# permitted source of Targetroles.
DESIGNATIONS_PATH=/absolute/path/to/igot_designations.csv

# Cached designation embedding index. Build once:
#   python tools/build_designation_index.py
# Without it the run falls back to lexical-only retrieval, which has noticeably
# worse recall for semantic matches (a waste-management course will not
# lexically match "Sanitation Inspector").
DESIGNATION_INDEX_PATH=data/designation_index.npz

# ── Throughput ───────────────────────────────────────────────────────────────
MAX_CONCURRENCY=4          # default for --batch-size
WORKER_BATCH_SIZE=20       # rows claimed from the queue per round
MAX_ATTEMPTS=3             # per-course tries before status becomes 'dead'
DESIGNATION_CANDIDATES=150 # shortlist size given to the model
LLM_TIMEOUT_SECONDS_META=300
STALE_CLAIM_MINUTES=30     # reclaim rows stranded 'in_progress' by a killed run

# ── Generation tuning ────────────────────────────────────────────────────────
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=32768

# Prompt-size guardrails, so one outlier course cannot blow up a request.
MAX_TRANSCRIPT_CHARS=400000
MAX_PDF_CHARS=200000
MAX_PDFS_PER_COURSE=40

# ── PDFs the text layer cannot handle ────────────────────────────────────────
# PyMuPDF does no OCR, so a scanned PDF extracts to nothing; and Indic PDFs in
# legacy non-Unicode fonts extract to plausible ASCII gibberish, which is worse
# because the model reads it as real text. Those are sent to the model as files
# instead, which reads them correctly. Fires on ~10% of PDFs.
#
# Rendering pages is expensive: ~30k tokens and ~380s for one 14.5 MB document
# against ~2k tokens for a text layer. Hence the three limits. Note the 10 MB /
# 50-page defaults exclude the only legacy-font document found in this corpus
# (14.2 MB, 54 pages) — raise to 15 / 60 to cover it.
MAX_NATIVE_PDFS=3
MAX_NATIVE_PDF_MB=10
MAX_NATIVE_PDF_PAGES=50

# ── Pricing, used only for the run cost report ───────────────────────────────
# USD per 1M tokens. Defaults are gemini-3.1-pro-preview at the <=200k-prompt
# tier ($4/$18 above 200k; prompts here run 55k-140k). Verify against
# cloud.google.com/vertex-ai/generative-ai/pricing — these are only as current as
# whoever last edited this file. Thinking tokens bill at the output rate and are
# included in the report; there are more of them than of the visible answer.
PRICE_INPUT_PER_M=2.00
PRICE_OUTPUT_PER_M=12.00
PRICE_CACHED_INPUT_PER_M=0.20

# ── Embeddings (designation retrieval) ───────────────────────────────────────
# Changing model or dim invalidates the cached index — rebuild with --force.
# To align with the production service instead, use gemini-embedding-2 at 768
# and prefix queries "task: sentence similarity | query: ".
DESIGNATION_EMBED_MODEL=text-embedding-005
DESIGNATION_EMBED_DIM=768
DESIGNATION_EMBED_BATCH=250

# ── Output contract (change deliberately — these alter the JSON) ─────────────
PROMPT_VERSION=v3.5-advanced
GENERATOR_NAME=iGOT Metadata Regeneration Engine (Vertex AI / Gemini)

# "Behavioural" matches the KCM master data. The v3.5 spec document writes
# "Behavioral"; set that only if a downstream consumer requires it.
BEHAVIOURAL_SPELLING=Behavioural

# "unlabelled" keeps v3.4's clean learner-facing outcomes; "why_how_what"
# follows the literal spec and prefixes each outcome "Why:"/"How:"/"What:".
LEARNING_OUTCOME_STYLE=unlabelled

# Rubric weights, must sum to 100. Blank = v3.5 spec defaults
# (LO:10,PK:5,BT:10,CC:15,ERO:20,EOL:25,TAA:15).
# The v3.4 code used LO:5,PK:5,BT:25,CC:35,ERO:10,EOL:20,TAA:0.
RUBRIC_WEIGHTS=
RUBRIC_BEGINNER_MAX=45
RUBRIC_INTERMEDIATE_MAX=75

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_DIR=logs
# Deliberately not LOG_LEVEL: a shared .env may set that to DEBUG for another
# service, which would make this run unreadably verbose.
META_GEN_LOG_LEVEL=INFO
